{
  "version": 2,
  "builds": [
    {
      "src": "vercel-build.py",
      "use": "@vercel/python"
    },
    {
      "src": "urlshortener/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "vercel-build.py" }
  ],
  "build": {
    "env": {
      "DJANGO_SETTINGS_MODULE": "urlshortener.settings"
    },
    "commands": [
      "python manage.py migrate --noinput"
    ]
  }
}